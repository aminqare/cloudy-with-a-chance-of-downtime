# Keep 127.0.0.1 when Nginx or Caddy runs on the same server.
BIND_ADDRESS=127.0.0.1
PUBLIC_PORT=3000

# Optional corroborating weather providers. Keep these server-side; never expose them in browser code.
# When configured, the server polls both providers and aggregates condition + warning votes.
OPENWEATHER_API_KEY=
WEATHERAPI_KEY=
